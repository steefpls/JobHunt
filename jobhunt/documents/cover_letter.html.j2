<!--
  Cover letter (adapted from Hyde's JobHunt template). Keep it to one page.
-->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ contact.name }} - Cover Letter - {{ company }}</title>
<style>
  @page { size: A4; margin: 22mm 20mm; }
  body { font-family: Georgia, "Times New Roman", serif; color: #1a1a1a; font-size: 11pt; line-height: 1.55; margin: 0; }
  .sender { margin-bottom: 22px; }
  .sender .name { font-size: 15pt; font-weight: bold; font-family: "Helvetica Neue", Arial, sans-serif; }
  .sender .meta { font-size: 9.5pt; color: #555; }
  .date { margin-bottom: 18px; color: #555; }
  .recipient { margin-bottom: 18px; }
  p { margin: 0 0 11px; }
  .sign { margin-top: 22px; }
</style>
</head>
<body>
  <div class="sender">
    <div class="name">{{ contact.name }}</div>
    <div class="meta">{{ [contact.email, contact.phone, contact.location] | select | join(" • ") }}</div>
  </div>
  <div class="date">{{ date }}</div>
  <div class="recipient">Hiring Team<br />{{ company }}<br />Re: {{ role }}</div>
  <p>{{ cl.greeting or "Dear Hiring Team," }}</p>
  {% for para in cl.paragraphs %}<p>{{ para }}</p>
  {% endfor %}
  <div class="sign">Sincerely,<br /><br />{{ contact.name }}</div>
</body>
</html>
