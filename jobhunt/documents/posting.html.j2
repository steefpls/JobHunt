<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ p.title }} - {{ p.company }}</title>
<style>
  @page { size: A4; margin: 18mm 18mm; }
  body { font-family: Arial, Helvetica, sans-serif; color: #222; font-size: 10.5pt; line-height: 1.45; margin: 0; }
  h1 { font-size: 16pt; margin: 0 0 2px; }
  .co { font-size: 12pt; color: #444; margin-bottom: 8px; }
  .meta { font-size: 9pt; color: #666; border-bottom: 1px solid #ccc; padding-bottom: 8px; margin-bottom: 12px; word-break: break-all; }
  .text { white-space: pre-wrap; }
</style>
</head>
<body>
  <h1>{{ p.title }}</h1>
  <div class="co">{{ p.company }}{% if p.location %} &middot; {{ p.location }}{% endif %}{% if p.salary %} &middot; {{ p.salary }}{% endif %}</div>
  <div class="meta">Source: {{ p.source }} &middot; Captured {{ captured }}<br />{{ p.url }}</div>
  <div class="text">{{ p.text }}</div>
</body>
</html>
